{
  "name": "urna",
  "version": "1.0.0",
  "private": true,
  "description": "Brazilian election poll tracker: every published poll, a smoothed average and pollster accuracy, the vote by municipality, Congress and the 2026 elected.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "ship": "bash scripts/publish.sh",
    "data": "uv run python -m pipeline.build",
    "crawler": "uv run python -m pipeline.crawl",
    "map": "uv run python -m pipeline.fetch_tse_results && uv run python -m pipeline.municipal_map",
    "apuracao:cidades": "uv run python -m pipeline.apuracao_cidades",
    "census": "uv run python -m pipeline.census_vote",
    "capitals": "uv run python -m pipeline.capitals",
    "profiles": "uv run python -m pipeline.profiles",
    "refresh": "uv run python -m pipeline.refresh",
    "americas": "uv run python -m pipeline.americas.discover && uv run python -m pipeline.americas.geo && uv run python -m pipeline.americas.build && uv run python -m pipeline.americas.indicators",
    "test": "vitest run",
    "test:data": "uv run pytest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests/web",
    "check": "npm run typecheck && npm test && uv run ruff check pipeline tests && npm run test:data && uv run python -m pipeline.build --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "jsdom": "^27.0.1",
    "mapshaper": "^0.7.78",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "fflate": "^0.8.3",
    "image-size": "^2.0.4",
    "file-type": "^21.3.1"
  }
}
