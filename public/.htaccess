# Hostinger (Apache). Copied by the build into public_html/urna/.

Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Files under assets/ carry a content hash and never change: cached for a year.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|woff2|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # The page always asks for the new version, so an update shows up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
