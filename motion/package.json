{
  "name": "urna-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Motions and interactive infographics from the site's data, made with Remotion.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:mapa": "remotion render src/index.ts Mapa out/mapa.mp4",
    "render:pesquisas": "remotion render src/index.ts Pesquisas out/pesquisas.mp4",
    "render:congresso": "remotion render src/index.ts Congresso out/congresso.mp4",
    "render:apuracao": "remotion render src/index.ts Apuracao out/apuracao.mp4",
    "render:apuracao-r1": "remotion render src/index.ts Apuracao out/apuracao-1turno.mp4 --props='{\"round\":\"r1\"}'",
    "render:cota": "remotion render src/index.ts Cota out/cota.mp4",
    "render:americas": "remotion render src/index.ts Americas out/americas.mp4",
    "render:video": "remotion render src/index.ts VideoPesquisas out/video-pesquisas.mp4",
    "render:video-sem-trilha": "remotion render src/index.ts VideoPesquisas out/video-pesquisas-sem-trilha.mp4 --props='{\"music\":false}'",
    "render:pobreza-numeros": "remotion render src/index.ts PobrezaNumeros out/pobreza-numeros.mp4 && remotion render src/index.ts PobrezaNumeros-horizontal out/pobreza-numeros-horizontal.mp4",
    "render:epocas": "remotion render src/index.ts Epocas out/epocas.mp4 && remotion render src/index.ts Epocas-horizontal out/epocas-horizontal.mp4",
    "render:fome": "remotion render src/index.ts Fome out/fome.mp4 && remotion render src/index.ts Fome-horizontal out/fome-horizontal.mp4",
    "render:capitais": "sh scripts/render-capitais.sh",
    "render:saopaulo": "remotion render src/index.ts SaoPaulo out/saopaulo-casais.mp4",
    "render:americas-fundo": "remotion render src/index.ts Americas-horizontal out/americas-fundo.mp4 --props='{\"texto\":false}'",
    "render:idh-explicador": "remotion render src/index.ts IdhExplicador out/idh/o-que-e-o-idh.mp4",
    "render:idhm-municipios": "remotion render src/index.ts IdhmMunicipios out/idh/idhm-municipios.mp4",
    "render:idhm-estados": "remotion render src/index.ts IdhmEstados out/idh/idhm-estados.mp4",
    "render:idh-chile": "remotion render src/index.ts IdhComparativo out/idh/brasil-x-chile.mp4 --props='{\"pais\":\"CHL\"}'",
    "render:idh-mexico": "remotion render src/index.ts IdhComparativo out/idh/brasil-x-mexico.mp4 --props='{\"pais\":\"MEX\"}'",
    "render:idh-argentina": "remotion render src/index.ts IdhComparativo out/idh/brasil-x-argentina.mp4 --props='{\"pais\":\"ARG\"}'",
    "render:idh-americas": "remotion render src/index.ts IdhAmericas out/idh/idh-americas.mp4",
    "render:idh-argentina-pobreza": "remotion render src/index.ts IdhArgentina out/idh/argentina-idh-e-pobreza.mp4",
    "render:idh": "npm run render:idh-explicador && npm run render:idhm-municipios && npm run render:idhm-estados && npm run render:idh-chile && npm run render:idh-mexico && npm run render:idh-argentina && npm run render:idh-americas && npm run render:idh-argentina-pobreza",
    "render:pobreza": "remotion render src/index.ts PobrezaAmericas out/idh/pobreza-americas.mp4",
    "render": "npm run render:mapa && npm run render:pesquisas && npm run render:congresso && npm run render:apuracao && npm run render:cota && npm run render:americas",
    "interativo": "vite",
    "build:interativo": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/google-fonts": "^4.0.535",
    "@remotion/player": "^4.0.535",
    "@remotion/transitions": "^4.0.535",
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
